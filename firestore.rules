rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read their own user document.
    // This assumes that the document ID in the 'users' collection
    // is the same as the user's UID from Firebase Authentication.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Add other rules for write, update, delete as needed.
      // For now, keeping them restricted.
      allow write, update, delete: if false; 
    }

    // Add rules for other collections in your database here.
    // For example, if you have a 'courses' collection that everyone
    // can read, you would add:
    // match /courses/{courseId} {
    //   allow read: if request.auth != null;
    //   allow write: if false; // Or some admin role check
    // }
  }
}

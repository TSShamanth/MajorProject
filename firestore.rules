rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read their own user document.
    // This assumes that the document ID in the 'users' collection
    // is the same as the user's UID from Firebase Authentication.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      // Add other rules for write, update, delete as needed.
      // For now, keeping them restricted.
      allow list, write, update, delete: if false; 
    }

    // This is the new rule that matches your database structure.
    // It allows a logged-in user to read their own document.
    match /Institutions/{institutionId}/users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin' || request.auth.token.role == 'faculty');
      allow list: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'faculty');
      allow write, update, delete: if request.auth != null && request.auth.token.role == 'admin'; 
    }

    // Mentorship Meetings: Mentors and their Mentees can access
    match /Institutions/{institutionId}/mentor_meetings/{meetingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'faculty' || request.auth.token.role == 'admin');
    }

    // Mentee Concerns: Students can raise, Mentors can view/resolve
    match /Institutions/{institutionId}/mentee_concerns/{concernId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.token.role == 'student';
      allow update: if request.auth != null && (request.auth.token.role == 'faculty' || request.auth.token.role == 'admin');
    }

    // Add rules for other collections in your database here.
    // For example, if you have a 'courses' collection that everyone
    // can read, you would add:
    // match /courses/{courseId} {
    //   allow read: if request.auth != null;
    //   allow write: if false; // Or some admin role check
    // }
  }
}
